# Optional Compose host bindings. Internal service ports do not change.
CWS_BIND_ADDRESS=0.0.0.0
CWS_API_PORT=8000
CWS_UI_PORT=8501
# MLflow has no authentication: keep it local or behind an authenticated proxy.
CWS_MLFLOW_BIND_ADDRESS=127.0.0.1
CWS_MLFLOW_PORT=5000

# Local processes only (Compose supplies the UI's http://api:8000 internally).
# CWS_API_URL=http://localhost:8000
# CWS_CONFIG=configs/config.yaml
# CWS_MODEL_PATH=models/production.json
# CWS_MONITOR_LOG=monitoring/events.jsonl
# MLFLOW_TRACKING_URI=http://localhost:5000
# Without an override local training retains sqlite:///.../mlruns/mlflow.db.
